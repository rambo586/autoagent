{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rambo586/autoagent/schemas/gate-result.schema.json",
  "title": "AutoAgent Gate Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "iteration", "reviewer", "verdict", "criteria", "next_iteration"],
  "properties": {
    "schema_version": {"const": "autoagent.gate/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pass", "fail", "partial", "timeout"]},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pass", "fail", "not_run"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description"],
        "properties": {
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "location": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "next_iteration": {
      "type": "object",
      "required": ["required", "goals"],
      "properties": {
        "required": {"type": "boolean"},
        "goals": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
